# ManeFlow 2.22.0-beta.1 — local beta and production foundation
PORT=4321
HOST=127.0.0.1
PUBLIC_BASE_URL=http://127.0.0.1:4321
RELEASE_CHANNEL=production-foundation-beta
NODE_ENV=development

# Local beta behavior. Disable demo mode only after approved completed-sale data is loaded.
MANEFLOW_DEMO_MODE=true
MANEFLOW_REQUIRE_AUTHENTICATION=true
MANEFLOW_ALLOW_GUEST_WRITES=false
MANEFLOW_ALLOW_PUBLIC_SIGNUPS=true
MANEFLOW_REQUIRE_EMAIL_VERIFICATION=true
MANEFLOW_CSRF_PROTECTION=true
# Forwarded client-IP headers are ignored unless both settings explicitly trust
# the immediate proxy connection.
TRUST_PROXY=false
TRUSTED_PROXY_ADDRESSES=127.0.0.1,::1
MANEFLOW_ALLOW_LEGACY_ADMIN_TOKEN=false
MANEFLOW_EXPOSE_DEV_TOKENS=false
MANEFLOW_ACCOUNT_TOKEN_MINUTES=60
MANEFLOW_SESSION_DAYS=30
# Owner and administrator authority must be provisioned out of band. Public signup never elevates roles.
MANEFLOW_BOOTSTRAP_ADMIN_EMAIL=
MANEFLOW_PLATFORM_OWNER_USER_IDS=
MANEFLOW_OWNER_RECENT_REAUTH_MINUTES=15

# ManeBrain Meta remains fail-closed until the immutable owner account, MFA, exact assets,
# approved permissions, signed webhook round trip, and owner-approved send path are verified.
# Callback URL: ${PUBLIC_BASE_URL}/api/webhooks/meta
MANEBRAIN_META_INTAKE_ENABLED=false
MANEBRAIN_META_KILL_SWITCH=true
MANEBRAIN_META_OUTBOUND_ENABLED=false
# Direct messages are the safe default. Add comment channels only after exact provider contract tests.
MANEBRAIN_META_OUTBOUND_CHANNELS=messenger,instagram_dm
MANEBRAIN_META_MAX_DISPATCH_BATCH=10
MANEBRAIN_META_POLL_INTERVAL_MS=5000
# Owner approval expires before send if it is older than this.
MANEBRAIN_META_APPROVAL_MAX_AGE_MS=900000
# Lease must be strictly greater than META_REQUEST_TIMEOUT_MS plus this margin.
MANEBRAIN_META_OUTBOUND_LEASE_MS=30000
MANEBRAIN_META_OUTBOUND_LEASE_MARGIN_MS=5000
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Use only exact hosts observed and approved for the configured Meta products.
META_ATTACHMENT_ALLOWED_HOSTS=
META_ATTACHMENT_MAX_BYTES=20000000
META_ATTACHMENT_MAX_REDIRECTS=3
META_ATTACHMENT_TIMEOUT_MS=20000
META_APP_ID=
META_BUSINESS_ID=
META_PAGE_ID=
META_INSTAGRAM_ACCOUNT_ID=
# Pin the exact Graph API version approved during integration testing. Never use "latest".
META_GRAPH_API_VERSION=
META_FACEBOOK_GRAPH_BASE_URL=https://graph.facebook.com
META_INSTAGRAM_GRAPH_BASE_URL=https://graph.instagram.com
# Store tokens only in the deployment secret manager. Never commit real values.
META_PAGE_ACCESS_TOKEN=
META_INSTAGRAM_ACCESS_TOKEN=
META_REQUEST_TIMEOUT_MS=15000

# AI-generated reply drafts remain DRAFT and require owner review, recent reauthentication,
# exact-text approval, and a separate queue action before provider dispatch.
OPENAI_API_BASE_URL=https://api.openai.com/v1
MANEBRAIN_DRAFT_MODEL=
MANEBRAIN_DRAFT_TIMEOUT_MS=20000

# Non-secret release provenance. Set these from the exact deployed commit and deployment records.
RELEASE_COMMIT_SHA=
RELEASE_DEPLOYED_AT=
RELEASE_ENVIRONMENT=development
MANEFLOW_WEB_RELEASE_ID=
MANEFLOW_API_RELEASE_ID=
MANEFLOW_VISION_RELEASE_ID=
MANEFLOW_MIGRATION_VERSION=008

# Generate separate long random values before network exposure.
MANEFLOW_API_TOKEN=
MANEFLOW_ADMIN_TOKEN=
MANEFLOW_SERVICE_TOKEN=
PROVIDER_WEBHOOK_SECRET=
ALLOWED_ORIGINS=https://memphiscardcompany.com,https://www.memphiscardcompany.com
MAX_REQUEST_BYTES=30000000

# PostgreSQL + pgvector. Use STORAGE_MODE=postgres after migrations pass.
STORAGE_MODE=json
DATABASE_URL=
DATABASE_SSL=false
DATABASE_POOL_MAX=20
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=15000
MANEFLOW_EMBEDDING_MODEL_NAME=siglip2-so400m-card-front-v1
MANEFLOW_EMBEDDING_MODEL_VERSION=1
MANEFLOW_HNSW_EF_SEARCH=100

# Local state is used only when STORAGE_MODE=json.
MANEFLOW_STATE_FILE=.runtime/state.json

# Server-owned folder intake. In production, mount MANEFLOW_SCAN_JOB_DIR on private,
# persistent storage and set MANEFLOW_SCAN_JOB_STORAGE_DURABLE=true only after verifying
# restart recovery, access controls, retention, deletion, backups, and rollback.
MANEFLOW_SCAN_JOB_DIR=.runtime/scan-jobs
MANEFLOW_SCAN_JOB_STORAGE_DURABLE=false
MANEFLOW_SCAN_JOB_MAX_ITEMS=1000
MANEFLOW_SCAN_JOB_MAX_ITEM_BYTES=20000000
MANEFLOW_SCAN_JOB_CONCURRENCY=2
MANEFLOW_SCAN_JOB_MAX_ATTEMPTS=2
MANEFLOW_SCAN_JOB_RETENTION_HOURS=24
MANEFLOW_SCAN_JOB_RETRY_BACKOFF_MS=1000

# Cache and billing.
CACHE_MODE=memory
REDIS_URL=
BILLING_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Transactional email webhook.
MANEFLOW_EMAIL_WEBHOOK_URL=
MANEFLOW_EMAIL_WEBHOOK_SECRET=

# Optional approved card-image sources.
MANEFLOW_REMOTE_IMAGE_HOSTS=
MANEFLOW_CARD_IMAGE_ALLOWED_HOSTS=
MANEFLOW_CARD_IMAGE_TEMPLATE=
MANEFLOW_CARD_IMAGE_SOURCE=
MANEFLOW_CARD_IMAGE_RIGHTS_NOTES=

# Local PP-OCRv6. The optional native package remains server/desktop-side only.
MANEFLOW_LOCAL_OCR_ENABLED=true
MANEFLOW_LOCAL_OCR_PROVIDER=auto
MANEFLOW_LOCAL_OCR_QUEUE_CAPACITY=4
MANEFLOW_LOCAL_OCR_TIMEOUT_MS=20000

# Local Python vision worker.
MANEFLOW_VISION_WORKER_URL=http://127.0.0.1:8741
MANEFLOW_VISION_WORKER_TIMEOUT_MS=120000
MANEFLOW_CORE_URL=http://127.0.0.1:4321
MANEFLOW_CORE_TIMEOUT_SECONDS=12
MANEFLOW_DATA_DIR=.runtime/vision-data
# Vision-worker folder imports are rejected unless they resolve beneath this root.
MANEFLOW_IMPORT_ALLOWED_ROOT=.runtime/vision-imports
# Wildcard origins are rejected; list explicit UI origins only.
CORS_ORIGINS_RAW=http://127.0.0.1:4321,http://localhost:4321

# Trained detector. Leave model path empty to use the conservative OpenCV fallback.
CARD_DETECTOR_BACKEND=auto
CARD_DETECTOR_MODEL_PATH=
CARD_DETECTOR_CONFIDENCE=0.35
CARD_DETECTOR_IOU=0.50
MAX_UPLOAD_BYTES=20000000
MAX_LOT_IMAGES=24
MAX_DETECTIONS_PER_IMAGE=100
DETECTOR_MAX_DIMENSION=1800
DETECTOR_MIN_AREA_FRACTION=0.012
DETECTOR_MAX_AREA_FRACTION=0.96

# Local ONNX image embedding engine. Requires a rights-cleared 1152-D model export.
MANEFLOW_EMBEDDING_ENABLED=false
MANEFLOW_EMBEDDING_MODEL_PATH=
MANEFLOW_EMBEDDING_EXECUTION_PROVIDER=auto
MANEFLOW_EMBEDDING_OUTPUT_NAME=
MANEFLOW_EMBEDDING_INPUT_SIZE=384
MANEFLOW_EMBEDDING_GPU_DEVICE_ID=0
MANEFLOW_EMBEDDING_INTRA_OP_THREADS=2

# Server-side optional AI vision and ManeBrain draft generation.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=

# PSA partner cert verification. PSA_API_TOKEN is accepted as a legacy alias.
PSA_API_KEY=
PSA_API_TOKEN=
PSA_API_BASE_URL=https://api.psacard.com/publicapi/cert/GetByCertNumber
PSA_AUTH_SCHEME=bearer

# eBay official APIs.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENVIRONMENT=production
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_MARKETPLACE_INSIGHTS_ENABLED=false
EBAY_USER_ACCESS_TOKEN=
EBAY_USER_ACCESS_TOKEN_EXPIRES_AT=
EBAY_REFRESH_TOKEN=
EBAY_REDIRECT_URI_NAME=
EBAY_USER_SCOPES=https://api.ebay.com/oauth/api_scope https://api.ebay.com/oauth/api_scope/sell.fulfillment.readonly
EBAY_REQUEST_TIMEOUT_MS=15000
EBAY_MAX_RETRIES=3
EBAY_MIN_BACKOFF_MS=400
EBAY_OAUTH_STATE_SECRET=
EBAY_OAUTH_STATE_TTL_MS=600000

# TCG and sports-card market/catalog context.
JUSTTCG_API_KEY=
JUSTTCG_BASE_URL=https://api.justtcg.com/v1
JUSTTCG_TIMEOUT_MS=15000
SPORTSCARDSPRO_API_TOKEN=
SPORTSCARDSPRO_BASE_URL=https://www.sportscardspro.com
SPORTSCARDSPRO_TIMEOUT_MS=15000
TCGPLAYER_PUBLIC_KEY=
TCGPLAYER_PRIVATE_KEY=

# Desktop/web embedding controls.
MANEFLOW_WIDGET_ALLOWED_ORIGINS=https://memphiscardcompany.com,https://www.memphiscardcompany.com
MANEFLOW_DESKTOP_MODE=cloud
MANEFLOW_CLOUD_URL=https://app.memphiscardcompany.com
MANEFLOW_LOCAL_URL=http://127.0.0.1:4321

# Roboflow card-scene instance segmentation (server-side only).
ROBOFLOW_DETECTION_ENABLED=false
ROBOFLOW_MODEL_ENDPOINT=
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_NAME=maneflow-card-scene-segmenter
ROBOFLOW_CONFIDENCE=0.35
ROBOFLOW_OVERLAP=30
ROBOFLOW_TIMEOUT_SECONDS=20
ROBOFLOW_FAIL_OPEN=true
