# Copy to /srv/maneflow/.env.staging on the staging host.
# Never commit the populated file. Generate all secrets independently.
# Image references and release provenance belong in .release.staging.

# First-party hostname and certificate contact.
MANEFLOW_DOMAIN=app.memphiscardcompany.com
ACME_EMAIL=memphiscardcompany@gmail.com

# Database. URL-encode passwords before embedding them in connection URLs.
POSTGRES_DB=maneflow_staging
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
MANEFLOW_DATABASE_APP_PASSWORD=REPLACE_WITH_DIFFERENT_LONG_RANDOM_SECRET
POSTGRES_ADMIN_DATABASE_URL=postgresql://postgres:URL_ENCODED_ADMIN_PASSWORD@postgres:5432/maneflow_staging
MANEFLOW_APP_DATABASE_URL=postgresql://maneflow_app:URL_ENCODED_APP_PASSWORD@postgres:5432/maneflow_staging

# Application and internal-service secrets. Every value must be different.
MANEFLOW_API_TOKEN=REPLACE_WITH_LONG_RANDOM_SECRET
MANEFLOW_SERVICE_TOKEN=REPLACE_WITH_DIFFERENT_LONG_RANDOM_SECRET
PROVIDER_WEBHOOK_SECRET=REPLACE_WITH_DIFFERENT_LONG_RANDOM_SECRET
EBAY_OAUTH_STATE_SECRET=REPLACE_WITH_DIFFERENT_LONG_RANDOM_SECRET

# Transactional email service webhook. Use staging credentials and recipients.
MANEFLOW_EMAIL_WEBHOOK_URL=https://REPLACE_WITH_APPROVED_STAGING_EMAIL_ENDPOINT
MANEFLOW_EMAIL_WEBHOOK_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# Beta behavior.
MANEFLOW_ALLOW_PUBLIC_SIGNUPS=true
MANEFLOW_DEMO_MODE=true

# Durable folder intake. Begin conservatively and tune only from measured load tests.
MANEFLOW_SCAN_JOB_MAX_ITEMS=1000
MANEFLOW_SCAN_JOB_MAX_ITEM_BYTES=20000000
MANEFLOW_SCAN_JOB_CONCURRENCY=2
MANEFLOW_SCAN_JOB_MAX_ATTEMPTS=2
MANEFLOW_SCAN_JOB_RETENTION_HOURS=24

# Vision defaults remain CPU-safe until a compatible cloud GPU is provisioned and measured.
MANEFLOW_COMPUTE_DEVICE=cpu
MANEFLOW_GPU_ALLOW_CPU_FALLBACK=false
MANEFLOW_EMBEDDING_ENABLED=false
MANEFLOW_EMBEDDING_MODEL_PATH=
MANEFLOW_EMBEDDING_EXECUTION_PROVIDER=auto
CARD_DETECTOR_BACKEND=classical
CARD_DETECTOR_MODEL_PATH=
