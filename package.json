{
  "name": "maneflow-card-intelligence",
  "version": "2.22.0-beta.1",
  "private": true,
  "type": "module",
  "description": "ManeFlow consolidated Windows/mobile/web beta with zero-input card recognition, any-order photo grouping, rights-gated adaptive learning, PSA verification, pricing, inventory, and eBay integration.",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check": "node scripts/check.js",
    "test": "node --test tests/*.test.js",
    "smoke": "node scripts/smoke-test.js",
    "verify": "npm run check && npm test && npm run smoke && npm run mobile:check && npm run desktop:check",
    "package": "node scripts/package-release.js",
    "setup": "node scripts/first-run.js",
    "doctor": "node scripts/doctor.js",
    "doctor:strict": "node scripts/doctor.js --strict",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "mobile:check": "node scripts/check-mobile.js",
    "desktop:check": "node scripts/check-desktop.js",
    "store:check": "node scripts/check-store-readiness.js",
    "recognition:benchmark": "node scripts/run-recognition-benchmark.mjs",
    "recognition:benchmark:folder": "node scripts/run-recognition-folder-benchmark.mjs",
    "recognition:discover:ebay": "node scripts/discover-ebay-benchmark-images.mjs",
    "verify:release": "node scripts/verify-release.js",
    "vision:test": "cd vision-worker && pytest -q",
    "verify:beta": "npm run check && npm run security:scan && npm test && npm run smoke && npm run vision:test && npm run integration:beta && npm run mobile:check && npm run desktop:check",
    "integration:beta": "node scripts/integration-beta-smoke.mjs",
    "security:scan": "node scripts/scan-secrets.mjs",
    "db:migrate": "node scripts/migrate-postgres.js",
    "db:verify": "node scripts/verify-postgres-schema.js",
    "package:windows-beta": "node scripts/package-windows-beta.js",
    "package:checksums": "node scripts/write-release-checksums.js",
    "package:beta": "npm run package && npm run verify:release && npm run package:windows-beta && npm run package:checksums",
    "vision:dataset:seed": "cd vision-worker && python tools/build_roboflow_seed_dataset.py",
    "vision:segmentation:evaluate": "cd vision-worker && python tools/evaluate_segmentation_model.py",
    "vision:encoder:export": "cd vision-worker && python tools/export_siglip2_encoder.py",
    "catalog:import:ndjson": "node scripts/import-authorized-catalog-ndjson.mjs",
    "db:test:rls": "node scripts/test-postgres-rls.js",
    "vision:ricoh:benchmark": "cd vision-worker && python tools/benchmark_ricoh_folder.py",
    "vision:gate": "node scripts/score-vision-release-gates.mjs",
    "store:external-gates": "node scripts/check-external-release-gates.mjs",
    "vision:scene:benchmark": "cd vision-worker && python tools/evaluate_scene_detector_manifest.py",
    "vision:pipeline:benchmark": "cd vision-worker && python tools/benchmark_full_vision_pipeline.py",
    "provider:psa:live": "node scripts/psa-live-smoke.mjs",
    "recognition:live-images": "node scripts/run-live-image-suite.mjs",
    "verify:ship": "node scripts/verify-ready-to-ship.mjs",
    "release:ship": "npm run verify:ship && npm run package:beta",
    "test:images": "node scripts/test-user-images.mjs",
    "training:prepare": "python scripts/prepare_owner_training_corpus.py",
    "training:run": "python scripts/run_adaptive_training.py",
    "training:status": "python scripts/training_status.py",
    "training:collect:huggingface": "python scripts/collect_public_images.py --source huggingface",
    "verify:consolidated": "npm run check && npm test && npm run smoke && npm run vision:test && npm run mobile:check && npm run desktop:check && npm run training:prepare && npm run training:calibrate-grouping && npm run training:auto-label && npm run training:run",
    "training:calibrate-grouping": "python scripts/train_grouping_calibration.py",
    "training:auto-label": "python scripts/auto_resolve_owner_labels.py",
    "training:daemon": "python scripts/adaptive_learning_daemon.py",
    "training:cycle": "python scripts/adaptive_learning_daemon.py --once --force"
  },
  "engines": {
    "node": ">=22"
  },
  "optionalDependencies": {
    "justtcg-js": "0.2.1",
    "@arcships/light-ocr": "0.3.0"
  },
  "dependencies": {
    "pg": "8.16.3"
  }
}
