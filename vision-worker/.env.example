APP_ENV=development
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
REDIS_URL=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=maneflow-card-images
OPENAI_API_KEY=
OPENAI_VISION_MODEL=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
PSA_API_KEY=
MAX_UPLOAD_BYTES=10000000
MAX_LOT_IMAGES=24
MAX_DETECTIONS_PER_IMAGE=100
DETECTOR_MAX_DIMENSION=1800
DETECTOR_MIN_AREA_FRACTION=0.012
DETECTOR_MAX_AREA_FRACTION=0.96
CARD_DETECTOR_BACKEND=auto
CARD_DETECTOR_MODEL_PATH=
CARD_DETECTOR_CONFIDENCE=0.35
CARD_DETECTOR_IOU=0.50
DEV_DATABASE_PATH=./var/maneflow_dev.sqlite3
DEFAULT_MARKETPLACE_FEE_RATE=0.1325
DEFAULT_PAYMENT_FEE_FIXED=0.30
DEFAULT_TARGET_ROI=0.25
CORS_ORIGINS_RAW=http://localhost:8081,http://localhost:19006
# Roboflow trained instance-segmentation model. Copy the exact endpoint from the
# Roboflow deployment page, for example https://outline.roboflow.com/project/1.
ROBOFLOW_DETECTION_ENABLED=false
ROBOFLOW_MODEL_ENDPOINT=
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_NAME=maneflow-card-scene-segmenter
ROBOFLOW_CONFIDENCE=0.35
ROBOFLOW_OVERLAP=30
ROBOFLOW_TIMEOUT_SECONDS=20
ROBOFLOW_JPEG_QUALITY=92
ROBOFLOW_FAIL_OPEN=true

# Central CPU/CUDA compute policy. auto selects CUDA only for compatible neural workloads.
MANEFLOW_COMPUTE_DEVICE=auto
MANEFLOW_GPU_DEVICE_ID=0
MANEFLOW_GPU_MEMORY_FRACTION=0.85
MANEFLOW_GPU_ALLOW_CPU_FALLBACK=true
MANEFLOW_GPU_MIXED_PRECISION=true
MANEFLOW_GPU_MAX_BATCH_SIZE=auto
MANEFLOW_GPU_EXECUTION_PROFILE=interactive
MANEFLOW_ONNX_TENSORRT_ENABLED=false
